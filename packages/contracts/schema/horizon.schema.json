{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon.local/contracts/v0/horizon.schema.json",
  "title": "Horizon shared contracts v0",
  "oneOf": [
    { "$ref": "#/$defs/Observation" },
    { "$ref": "#/$defs/NetworkObservation" },
    { "$ref": "#/$defs/FusedTrack" },
    { "$ref": "#/$defs/EvidenceBundle" },
    { "$ref": "#/$defs/ActuatorCapability" },
    { "$ref": "#/$defs/AIInferenceTrace" },
    { "$ref": "#/$defs/ProposedCommand" },
    { "$ref": "#/$defs/SourceHealth" },
    { "$ref": "#/$defs/PerceptionHealth" },
    { "$ref": "#/$defs/GovernorInput" },
    { "$ref": "#/$defs/RecoveryInput" },
    { "$ref": "#/$defs/AssuranceDecision" },
    { "$ref": "#/$defs/GateReceipt" },
    { "$ref": "#/$defs/SimulationSnapshot" },
    { "$ref": "#/$defs/EvaluationRecord" },
    { "$ref": "#/$defs/RunManifest" },
    { "$ref": "#/$defs/ArtifactManifest" }
  ],
  "$defs": {
    "SchemaVersion": { "type": "string", "const": "0.1.0" },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ProvenanceKind": { "type": "string", "enum": ["recorded", "synthetic", "unavailable"] },
    "CapabilityStatus": { "type": "string", "enum": ["available", "degraded", "unavailable", "output_only"] },
    "HealthStatus": { "type": "string", "enum": ["healthy", "degraded", "invalid", "unknown"] },
    "Vector2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "Matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols", "data"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "data": { "type": "array", "items": { "type": "number" }, "minItems": 1 }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id"],
      "properties": {
        "kind": { "$ref": "#/$defs/ProvenanceKind" },
        "source_id": { "type": "string", "minLength": 1 },
        "artifact_uri": { "type": ["string", "null"] },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "rights": { "type": ["string", "null"] }
      }
    },
    "TimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_time_s", "received_monotonic_ns", "valid_until_monotonic_ns", "clock_uncertainty_ms"],
      "properties": {
        "event_time_s": { "type": "number", "minimum": 0 },
        "received_monotonic_ns": { "type": "integer", "minimum": 0 },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 },
        "clock_uncertainty_ms": { "type": "number", "minimum": 0 }
      }
    },
    "Hull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length_m", "beam_m"],
      "properties": {
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "beam_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "BoundedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_radius_m", "heading_rad", "speed_mps", "assumption_id"],
      "properties": {
        "position_radius_m": { "type": "number", "minimum": 0 },
        "heading_rad": { "type": "number", "minimum": 0 },
        "speed_mps": { "type": "number", "minimum": 0 },
        "assumption_id": { "type": "string", "minLength": 1 }
      }
    },
    "Uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "covariance", "covariance_coverage", "bounded_error"],
      "properties": {
        "kind": { "type": "string", "enum": ["covariance", "bounded_set", "covariance+bounded_set", "unknown"] },
        "covariance": { "oneOf": [{ "$ref": "#/$defs/Matrix" }, { "type": "null" }] },
        "covariance_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "bounded_error": { "oneOf": [{ "$ref": "#/$defs/BoundedError" }, { "type": "null" }] }
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading_rad", "speed_mps"],
      "properties": {
        "heading_rad": { "type": "number" },
        "speed_mps": { "type": "number", "minimum": 0 },
        "trajectory_ne_m": { "type": "array", "items": { "$ref": "#/$defs/Vector2" } }
      }
    },
    "ActuatorCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "capability_version", "rudder_rad", "thrust_fraction", "rudder_limits_rad", "rudder_rate_limit_rps", "thrust_limits", "steering_lag_s", "propulsion_lag_s", "status"],
      "properties": {
        "contract_type": { "const": "ActuatorCapability" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "capability_version": { "type": "string", "minLength": 1 },
        "rudder_rad": { "type": "number" },
        "thrust_fraction": { "type": "number" },
        "rudder_limits_rad": { "$ref": "#/$defs/Vector2" },
        "rudder_rate_limit_rps": { "type": "number", "exclusiveMinimum": 0 },
        "thrust_limits": { "$ref": "#/$defs/Vector2" },
        "steering_lag_s": { "type": "number", "minimum": 0 },
        "propulsion_lag_s": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["nominal", "degraded", "invalid"] },
        "degradation_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "observation_id", "run_id", "branch_id", "input_group", "source_id", "sequence", "time", "units", "frame", "capability", "provenance", "payload"],
      "properties": {
        "contract_type": { "const": "Observation" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "observation_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "input_group": { "type": "string", "enum": ["navigation_environment", "obstacle_perception", "ship_actuator_feedback", "onboard_network", "internal_ship_communications", "inter_ship_communications", "decision_ai_telemetry", "neural_sensor_internals"] },
        "source_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "time": { "$ref": "#/$defs/TimeContext" },
        "units": { "type": "string", "minLength": 1 },
        "frame": { "type": "string", "minLength": 1 },
        "capability": { "$ref": "#/$defs/CapabilityStatus" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "payload": { "type": "object" }
      }
    },
    "NetworkObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "observation_id", "run_id", "branch_id", "source_id", "destination_id", "sequence", "time", "capture_status", "application_status", "provenance"],
      "properties": {
        "contract_type": { "const": "NetworkObservation" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "observation_id": { "type": "string" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "source_id": { "type": "string" },
        "destination_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "time": { "$ref": "#/$defs/TimeContext" },
        "capture_status": { "type": "string", "enum": ["observed", "lost", "unavailable"] },
        "application_status": { "type": "string", "enum": ["received", "consumed", "not_received", "unknown"] },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "FusedTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "track_id", "position_ne_m", "velocity_ne_mps", "hull", "age_s", "uncertainty", "supporting_observation_ids", "contradicting_observation_ids", "assumption_ids"],
      "properties": {
        "contract_type": { "const": "FusedTrack" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "track_id": { "type": "string" },
        "position_ne_m": { "$ref": "#/$defs/Vector2" },
        "velocity_ne_mps": { "$ref": "#/$defs/Vector2" },
        "hull": { "$ref": "#/$defs/Hull" },
        "age_s": { "type": "number", "minimum": 0 },
        "uncertainty": { "$ref": "#/$defs/Uncertainty" },
        "supporting_observation_ids": { "type": "array", "items": { "type": "string" } },
        "contradicting_observation_ids": { "type": "array", "items": { "type": "string" } },
        "assumption_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EvidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "bundle_id", "run_id", "branch_id", "observation_ids", "track_ids", "health_ids", "assumption_ids", "valid_until_monotonic_ns"],
      "properties": {
        "contract_type": { "const": "EvidenceBundle" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "bundle_id": { "type": "string" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "observation_ids": { "type": "array", "items": { "type": "string" } },
        "track_ids": { "type": "array", "items": { "type": "string" } },
        "health_ids": { "type": "array", "items": { "type": "string" } },
        "assumption_ids": { "type": "array", "items": { "type": "string" } },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "AIInferenceTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "trace_id", "run_id", "branch_id", "source_id", "model_version", "consumed_input_ids", "started_monotonic_ns", "completed_monotonic_ns", "status"],
      "properties": {
        "contract_type": { "const": "AIInferenceTrace" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "trace_id": { "type": "string" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "source_id": { "type": "string" },
        "model_version": { "type": "string" },
        "consumed_input_ids": { "type": "array", "items": { "type": "string" } },
        "started_monotonic_ns": { "type": "integer", "minimum": 0 },
        "completed_monotonic_ns": { "type": "integer", "minimum": 0 },
        "candidate_scores": { "type": "object", "additionalProperties": { "type": "number" } },
        "status": { "type": "string", "enum": ["ok", "late", "failed", "unknown"] }
      }
    },
    "ProposedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "run_id", "branch_id", "command_id", "source_id", "authority", "sequence", "origin_snapshot_id", "issued_monotonic_ns", "expires_monotonic_ns", "issued_simulation_time_s", "expires_simulation_time_s", "command", "inference_trace_id"],
      "properties": {
        "contract_type": { "const": "ProposedCommand" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "command_id": { "type": "string" },
        "source_id": { "type": "string" },
        "authority": { "type": "string", "enum": ["decision_ai", "operator", "replay_fixture"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "origin_snapshot_id": { "type": "string" },
        "issued_monotonic_ns": { "type": "integer", "minimum": 0 },
        "expires_monotonic_ns": { "type": "integer", "minimum": 0 },
        "issued_simulation_time_s": { "type": "number", "minimum": 0 },
        "expires_simulation_time_s": { "type": "number", "minimum": 0 },
        "command": { "$ref": "#/$defs/Command" },
        "inference_trace_id": { "type": "string" }
      }
    },
    "SourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "health_id", "source_id", "status", "reason_codes", "calibration_version", "supported_scope", "valid_until_monotonic_ns"],
      "properties": {
        "contract_type": { "const": "SourceHealth" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "health_id": { "type": "string" },
        "source_id": { "type": "string" },
        "status": { "$ref": "#/$defs/HealthStatus" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "calibration_version": { "type": ["string", "null"] },
        "supported_scope": { "type": "string" },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "PerceptionHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "health_id", "source_id", "method_id", "status", "reason_codes", "calibration_version", "reference_version", "supported_scope", "valid_until_monotonic_ns"],
      "properties": {
        "contract_type": { "const": "PerceptionHealth" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "health_id": { "type": "string" },
        "source_id": { "type": "string" },
        "method_id": { "type": "string", "enum": ["H0", "H1", "H2", "H3", "H4"] },
        "status": { "$ref": "#/$defs/HealthStatus" },
        "score": { "type": ["number", "null"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "calibration_version": { "type": ["string", "null"] },
        "reference_version": { "type": ["string", "null"] },
        "supported_scope": { "type": "string" },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "OwnshipState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_ne_m", "heading_rad", "velocity_body_mps", "yaw_rate_rps", "hull", "uncertainty"],
      "properties": {
        "position_ne_m": { "$ref": "#/$defs/Vector2" },
        "heading_rad": { "type": "number" },
        "velocity_body_mps": { "$ref": "#/$defs/Vector2" },
        "yaw_rate_rps": { "type": "number" },
        "hull": { "$ref": "#/$defs/Hull" },
        "uncertainty": { "$ref": "#/$defs/Uncertainty" }
      }
    },
    "ContactState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_id", "position_ne_m", "velocity_ne_mps", "heading_rad", "hull", "hull_orientation_source", "age_s", "uncertainty", "source_ids"],
      "properties": {
        "contact_id": { "type": "string" },
        "position_ne_m": { "$ref": "#/$defs/Vector2" },
        "velocity_ne_mps": { "$ref": "#/$defs/Vector2" },
        "heading_rad": { "type": ["number", "null"] },
        "hull": { "$ref": "#/$defs/Hull" },
        "hull_orientation_source": { "type": "string", "enum": ["measured", "velocity_inferred", "unknown_enclosing_circle"] },
        "age_s": { "type": "number", "minimum": 0 },
        "uncertainty": { "$ref": "#/$defs/Uncertainty" },
        "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "RecoveryOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_id", "valid_until_monotonic_ns", "assumption_id"],
      "properties": {
        "recovery_id": { "type": "string" },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 },
        "assumption_id": { "type": "string" }
      }
    },
    "GovernorHealthSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_id", "source_id", "status", "age_s", "capability", "reason_codes", "valid_until_monotonic_ns"],
      "properties": {
        "health_id": { "type": "string" },
        "source_id": { "type": "string" },
        "status": { "$ref": "#/$defs/HealthStatus" },
        "age_s": { "type": "number", "minimum": 0 },
        "capability": { "$ref": "#/$defs/CapabilityStatus" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "OperatingConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "geometry_ref", "minimum_margin", "units", "assumption_id", "configuration_version"],
      "properties": {
        "constraint_id": { "type": "string" },
        "kind": { "type": "string", "enum": ["collision", "water_boundary", "depth", "corridor", "actuator", "navigation_rule"] },
        "geometry_ref": { "type": ["string", "null"] },
        "minimum_margin": { "type": "number", "minimum": 0 },
        "units": { "type": "string" },
        "assumption_id": { "type": "string" },
        "configuration_version": { "type": "string" }
      }
    },
    "AssuranceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "frame", "valid_until_monotonic_ns", "ownship", "contacts", "environment", "actuator"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "frame": { "const": "NED" },
        "valid_until_monotonic_ns": { "type": "integer", "minimum": 0 },
        "ownship": { "$ref": "#/$defs/OwnshipState" },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/ContactState" } },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["water_boundary_id", "depth_field_id", "current_estimate_ne_mps", "current_bounded_error_ne_mps", "current_assumption_id"],
          "properties": {
            "water_boundary_id": { "type": "string" },
            "depth_field_id": { "type": "string" },
            "current_estimate_ne_mps": { "$ref": "#/$defs/Vector2" },
            "current_bounded_error_ne_mps": { "$ref": "#/$defs/Vector2" },
            "current_assumption_id": { "type": "string" }
          }
        },
        "actuator": { "$ref": "#/$defs/ActuatorCapability" }
      }
    },
    "AssuranceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_health_ids", "perception_health_id", "status"],
      "properties": {
        "source_health_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "perception_health_id": { "type": ["string", "null"] },
        "summaries": { "type": "array", "items": { "$ref": "#/$defs/GovernorHealthSummary" } },
        "status": { "$ref": "#/$defs/HealthStatus" }
      }
    },
    "RecoveryHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_health_ids", "perception_health_id", "summaries", "status"],
      "properties": {
        "source_health_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "perception_health_id": { "type": ["string", "null"] },
        "summaries": { "type": "array", "items": { "$ref": "#/$defs/GovernorHealthSummary" }, "minItems": 1 },
        "status": { "$ref": "#/$defs/HealthStatus" }
      }
    },
    "GovernorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "run_id", "episode_id", "branch_id", "tick_index", "simulation_time_s", "monotonic_time_ns", "decision_deadline_monotonic_ns", "configuration_hash", "snapshot", "proposal", "health", "constraints", "recovery_options"],
      "properties": {
        "contract_type": { "const": "GovernorInput" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "type": "string" },
        "episode_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "tick_index": { "type": "integer", "minimum": 0 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "monotonic_time_ns": { "type": "integer", "minimum": 0 },
        "decision_deadline_monotonic_ns": { "type": "integer", "minimum": 0 },
        "configuration_hash": { "$ref": "#/$defs/Sha256" },
        "snapshot": { "$ref": "#/$defs/AssuranceSnapshot" },
        "proposal": { "$ref": "#/$defs/ProposedCommand" },
        "health": { "$ref": "#/$defs/AssuranceHealth" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/OperatingConstraint" } },
        "recovery_options": { "type": "array", "items": { "$ref": "#/$defs/RecoveryOption" } }
      }
    },
    "RecoveryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "recovery_input_id", "run_id", "episode_id", "branch_id", "plant_epoch", "tick_index", "simulation_time_s", "monotonic_time_ns", "recovery_deadline_monotonic_ns", "configuration_hash", "snapshot", "health", "constraints", "recovery_options"],
      "properties": {
        "contract_type": { "const": "RecoveryInput" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "recovery_input_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "plant_epoch": { "type": "integer", "minimum": 0 },
        "tick_index": { "type": "integer", "minimum": 0 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "monotonic_time_ns": { "type": "integer", "minimum": 0 },
        "recovery_deadline_monotonic_ns": { "type": "integer", "minimum": 0 },
        "configuration_hash": { "$ref": "#/$defs/Sha256" },
        "snapshot": { "$ref": "#/$defs/AssuranceSnapshot" },
        "health": { "$ref": "#/$defs/RecoveryHealth" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/OperatingConstraint" } },
        "recovery_options": { "type": "array", "items": { "$ref": "#/$defs/RecoveryOption" } }
      }
    },
    "ConstraintEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "minimum_margin", "units", "assumption_id", "representation", "coverage"],
      "properties": {
        "constraint_id": { "type": "string" },
        "kind": { "type": "string", "enum": ["collision", "boundary", "grounding", "actuator", "recoverability"] },
        "minimum_margin": { "type": "number" },
        "units": { "type": "string" },
        "assumption_id": { "type": "string" },
        "representation": { "type": "string", "enum": ["deterministic", "bounded", "probabilistic"] },
        "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "AssuranceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "run_id", "episode_id", "branch_id", "tick_index", "input_snapshot_id", "proposal_id", "decision_id", "candidate_id", "candidate_version", "action", "authority", "issued_command", "decided_monotonic_ns", "expires_monotonic_ns", "compute_time_ns", "deadline_met", "reason_codes", "constraints", "recovery", "solver", "valid"],
      "properties": {
        "contract_type": { "const": "AssuranceDecision" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "type": "string" },
        "episode_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "tick_index": { "type": "integer", "minimum": 0 },
        "input_snapshot_id": { "type": "string" },
        "proposal_id": { "type": "string" },
        "decision_id": { "type": "string" },
        "candidate_id": { "type": "string", "enum": ["A1", "A2", "A3", "A4", "A5", "STUB"] },
        "candidate_version": { "type": "string" },
        "action": { "type": "string", "enum": ["pass", "modify", "recover", "minimum_risk", "invalid"] },
        "authority": { "type": "string", "enum": ["autonomy", "filtered_autonomy", "recovery"] },
        "issued_command": { "oneOf": [{ "$ref": "#/$defs/Command" }, { "type": "null" }] },
        "decided_monotonic_ns": { "type": "integer", "minimum": 0 },
        "expires_monotonic_ns": { "type": "integer", "minimum": 0 },
        "compute_time_ns": { "type": "integer", "minimum": 0 },
        "deadline_met": { "type": "boolean" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/ConstraintEvidence" } },
        "recovery": { "oneOf": [{ "$ref": "#/$defs/RecoveryOption" }, { "type": "null" }] },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "primal_residual", "dual_residual"],
          "properties": {
            "status": { "type": "string", "enum": ["not_used", "optimal", "infeasible", "timeout", "invalid"] },
            "primal_residual": { "type": ["number", "null"] },
            "dual_residual": { "type": ["number", "null"] }
          }
        },
        "valid": { "type": "boolean" }
      }
    },
    "GateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "receipt_id", "run_id", "branch_id", "decision_id", "command_id", "authority", "accepted", "reason_codes", "received_monotonic_ns", "actuated_monotonic_ns", "actual_command"],
      "properties": {
        "contract_type": { "const": "GateReceipt" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "receipt_id": { "type": "string" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "decision_id": { "type": "string" },
        "command_id": { "type": "string" },
        "authority": { "type": "string", "enum": ["autonomy", "filtered_autonomy", "recovery", "gate_watchdog"] },
        "accepted": { "type": "boolean" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "received_monotonic_ns": { "type": "integer", "minimum": 0 },
        "actuated_monotonic_ns": { "type": ["integer", "null"], "minimum": 0 },
        "actual_command": { "oneOf": [{ "$ref": "#/$defs/Command" }, { "type": "null" }] }
      }
    },
    "VesselSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vessel_id", "position_ne_m", "heading_rad", "speed_mps", "hull"],
      "properties": {
        "vessel_id": { "type": "string" },
        "position_ne_m": { "$ref": "#/$defs/Vector2" },
        "heading_rad": { "type": "number" },
        "speed_mps": { "type": "number", "minimum": 0 },
        "heave_down_m": { "type": "number", "description": "Display-only modeled heave, positive down from the nominal waterline." },
        "attitude_rp_rad": { "$ref": "#/$defs/Vector2", "description": "Display-only roll and pitch; body x forward, y starboard, z down. Positive roll starboard-down, positive pitch bow-up." },
        "angular_velocity_rp_rps": { "$ref": "#/$defs/Vector2" },
        "hull": { "$ref": "#/$defs/Hull" }
      }
    },
    "MarineEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "sea_state_id", "config_sha256", "current_ne_mps", "wind_ne_mps", "surface_elevation_m", "wave_direction_rad", "significant_wave_height_m", "peak_period_s", "qualification", "reason_codes"],
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "sea_state_id": { "type": "string", "minLength": 1 },
        "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "current_ne_mps": { "$ref": "#/$defs/Vector2" },
        "wind_ne_mps": { "$ref": "#/$defs/Vector2" },
        "surface_elevation_m": { "type": "number", "description": "Modeled water elevation, positive upward." },
        "wave_direction_rad": { "type": "number", "description": "Wave travel direction clockwise from north." },
        "significant_wave_height_m": { "type": "number", "minimum": 0 },
        "peak_period_s": { "type": "number", "exclusiveMinimum": 0 },
        "wave_components": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/WaveComponent" } },
        "qualification": { "type": "string", "enum": ["characterized", "degraded", "unknown"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "WaveComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amplitude_m", "wave_number_per_m", "angular_frequency_rad_s", "phase_rad", "direction_rad"],
      "properties": {
        "amplitude_m": { "type": "number", "minimum": 0 },
        "wave_number_per_m": { "type": "number", "minimum": 0 },
        "angular_frequency_rad_s": { "type": "number", "minimum": 0 },
        "phase_rad": { "type": "number" },
        "direction_rad": { "type": "number" }
      }
    },
    "SimulationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "snapshot_id", "run_id", "branch_id", "tick_index", "simulation_time_s", "frame", "ownship", "traffic", "active_command_id", "display_only"],
      "properties": {
        "contract_type": { "const": "SimulationSnapshot" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "snapshot_id": { "type": "string" },
        "run_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "tick_index": { "type": "integer", "minimum": 0 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "frame": { "const": "NED" },
        "ownship": { "$ref": "#/$defs/VesselSnapshot" },
        "traffic": { "type": "array", "items": { "$ref": "#/$defs/VesselSnapshot" } },
        "marine_environment": { "$ref": "#/$defs/MarineEnvironment" },
        "active_command_id": { "type": ["string", "null"] },
        "display_only": { "const": true }
      }
    },
    "EvaluationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "run_id", "episode_id", "branch_id", "candidate_id", "health_id", "scenario_id", "seed", "split", "recoverability_class", "truth_source_id", "completed", "duration_s", "violations", "margins", "intervention", "gate", "mission", "control", "runtime_ns", "deadline_misses", "trace_complete", "artifact_hashes"],
      "properties": {
        "contract_type": { "const": "EvaluationRecord" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "type": "string" },
        "episode_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "candidate_id": { "type": "string" },
        "health_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "seed": { "type": "integer" },
        "split": { "type": "string", "enum": ["development", "calibration", "heldout"] },
        "recoverability_class": { "type": "string", "enum": ["declared_recoverable", "initially_unrecoverable", "out_of_domain"] },
        "truth_source_id": { "type": "string" },
        "completed": { "type": "boolean" },
        "duration_s": { "type": "number", "minimum": 0 },
        "violations": { "type": "object", "required": ["collision_count", "grounding_count", "boundary_count"], "properties": { "collision_count": { "type": "integer", "minimum": 0 }, "grounding_count": { "type": "integer", "minimum": 0 }, "boundary_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        "margins": { "type": "object", "required": ["min_hull_clearance_m", "min_boundary_clearance_m", "min_ukc_m"], "properties": { "min_hull_clearance_m": { "type": "number" }, "min_boundary_clearance_m": { "type": "number" }, "min_ukc_m": { "type": "number" } }, "additionalProperties": false },
        "intervention": { "type": "object", "required": ["occurred", "first_time_s", "last_recovery_opportunity_s", "lead_time_s"], "properties": { "occurred": { "type": "boolean" }, "first_time_s": { "type": ["number", "null"] }, "last_recovery_opportunity_s": { "type": ["number", "null"] }, "lead_time_s": { "type": ["number", "null"] } }, "additionalProperties": false },
        "gate": { "type": "object", "required": ["unsafe_or_stale_accepted_count", "assessment_status"], "properties": { "unsafe_or_stale_accepted_count": { "type": "integer", "minimum": 0 }, "assessment_status": { "type": "string", "enum": ["complete", "unknown"] } }, "additionalProperties": false },
        "mission": { "type": "object", "required": ["completed", "censored", "route_delay_s", "extra_distance_m", "recovery_duration_s"], "properties": { "completed": { "type": "boolean" }, "censored": { "type": "boolean" }, "route_delay_s": { "type": ["number", "null"] }, "extra_distance_m": { "type": ["number", "null"] }, "recovery_duration_s": { "type": "number" } }, "additionalProperties": false },
        "control": { "type": "object", "required": ["authority_switches", "helm_reversals", "max_command_discontinuity"], "properties": { "authority_switches": { "type": "integer", "minimum": 0 }, "helm_reversals": { "type": "integer", "minimum": 0 }, "max_command_discontinuity": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
        "runtime_ns": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "deadline_misses": { "type": "integer", "minimum": 0 },
        "trace_complete": { "type": "boolean" },
        "artifact_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Sha256" } }
      }
    },
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "uri", "provenance", "rights"],
      "properties": {
        "artifact_id": { "type": "string" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "uri": { "type": "string" },
        "provenance": { "$ref": "#/$defs/ProvenanceKind" },
        "rights": { "type": "string" }
      }
    },
    "RunManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "study_id", "run_id", "experiment_mode", "split", "frozen", "created_utc", "scenario_id", "scenario_hash", "seed", "candidate_ids", "health_ids", "config_hash", "contracts_hash", "simulator_version", "governor_versions", "health_versions", "data_artifacts", "output_uri"],
      "properties": {
        "contract_type": { "const": "RunManifest" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "study_id": { "type": "string" },
        "run_id": { "type": "string" },
        "experiment_mode": { "type": "string", "enum": ["controller_isolation_replay", "full_pipeline_closed_loop"] },
        "split": { "type": "string", "enum": ["development", "calibration", "heldout"] },
        "frozen": { "type": "boolean" },
        "created_utc": { "type": "string", "format": "date-time" },
        "scenario_id": { "type": "string" },
        "scenario_hash": { "$ref": "#/$defs/Sha256" },
        "seed": { "type": "integer" },
        "candidate_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "health_ids": { "type": "array", "items": { "type": "string" } },
        "config_hash": { "$ref": "#/$defs/Sha256" },
        "contracts_hash": { "$ref": "#/$defs/Sha256" },
        "simulator_version": { "type": "string" },
        "governor_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "health_versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "data_artifacts": { "type": "array", "items": { "$ref": "#/$defs/ArtifactReference" } },
        "output_uri": { "type": "string" }
      }
    },
    "ArtifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "artifact_id", "version", "uri", "sha256", "rights", "provenance", "media_type", "available"],
      "properties": {
        "contract_type": { "const": "ArtifactManifest" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "artifact_id": { "type": "string" },
        "version": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "rights": { "type": "string" },
        "provenance": { "$ref": "#/$defs/ProvenanceKind" },
        "media_type": { "type": "string" },
        "available": { "type": "boolean" }
      }
    }
  }
}
